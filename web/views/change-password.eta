<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set Password — Vendo OS</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --vendo-font: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
      --vendo-green: #22C55E;
      --vendo-green-hover: #16A34A;
    }

    body {
      font-family: var(--vendo-font);
      background: #0B0B0B;
      color: #E2E8F0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      overflow: hidden;
      position: relative;
    }

    /* === Animated gradient orbs === */
    .bg-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.07;
      pointer-events: none;
      will-change: transform;
    }

    .bg-orb-1 {
      width: 600px;
      height: 600px;
      background: var(--vendo-green);
      top: -10%;
      left: -10%;
      animation: orb-drift-1 25s ease-in-out infinite;
    }

    .bg-orb-2 {
      width: 500px;
      height: 500px;
      background: #10B981;
      bottom: -15%;
      right: -10%;
      animation: orb-drift-2 30s ease-in-out infinite;
    }

    .bg-orb-3 {
      width: 350px;
      height: 350px;
      background: #FFFFFF;
      top: 40%;
      right: 30%;
      opacity: 0.03;
      animation: orb-drift-3 20s ease-in-out infinite;
    }

    @keyframes orb-drift-1 {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(80px, 50px); }
      66% { transform: translate(-40px, 80px); }
    }

    @keyframes orb-drift-2 {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(-60px, -40px); }
      66% { transform: translate(50px, -70px); }
    }

    @keyframes orb-drift-3 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-30px, 40px); }
    }

    /* === Noise texture overlay === */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      opacity: 0.035;
      pointer-events: none;
      z-index: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 128px 128px;
    }

    /* === Dot grid === */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .login-container {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 1;
      animation: card-enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes card-enter {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-logo {
      width: 64px;
      height: 64px;
      background: var(--vendo-green);
      color: #0B0B0B;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--vendo-font);
      font-weight: 700;
      font-size: 32px;
      margin-bottom: 1.5rem;
      box-shadow: 0 0 40px rgba(34, 197, 94, 0.2);
    }

    .login-brand {
      font-family: var(--vendo-font);
      font-size: 28px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .login-subtitle {
      font-size: 14px;
      color: #94A3B8;
      margin-bottom: 2rem;
      text-align: center;
    }

    /* Card — glassmorphism */
    .login-card {
      background: rgba(20, 20, 20, 0.55);
      backdrop-filter: saturate(180%) blur(40px);
      -webkit-backdrop-filter: saturate(180%) blur(40px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      padding: 2rem;
      width: 100%;
    }

    .login-card.shake { animation: shake 0.4s ease-in-out; }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-5px); }
      80% { transform: translateX(5px); }
    }

    .login-card label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #94A3B8;
      margin-bottom: 0.5rem;
    }

    .login-card input[type="password"],
    .login-card input[type="text"] {
      width: 100%;
      padding: 0.75rem 1rem;
      background: rgba(11, 11, 11, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      color: #E2E8F0;
      font-family: var(--vendo-font);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .login-card input:focus {
      border-color: var(--vendo-green);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }

    .login-card input::placeholder { color: #64748b; }

    .password-wrap { position: relative; }
    .password-wrap input { padding-right: 3rem; }

    .password-toggle {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      padding: 4px;
      cursor: pointer;
      color: #64748b;
      transition: color 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 6px;
    }

    .password-toggle:hover {
      color: #94A3B8;
      background: rgba(255, 255, 255, 0.04);
    }

    .password-toggle svg { width: 18px; height: 18px; }

    .field + .field { margin-top: 1rem; }

    .login-btn {
      width: 100%;
      margin-top: 1.5rem;
      padding: 0.75rem 1.25rem;
      background: var(--vendo-green);
      color: #0B0B0B;
      border: none;
      border-radius: 14px;
      font-family: var(--vendo-font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      min-height: 48px;
    }

    .login-btn:hover {
      background: var(--vendo-green-hover);
      box-shadow: 0 0 24px rgba(34, 197, 94, 0.25);
      transform: scale(1.02);
    }

    .login-btn:active { transform: scale(0.98); }

    .error-text {
      color: #ef4444;
      font-weight: 600;
      text-align: center;
      font-size: 14px;
      margin-bottom: 1rem;
      animation: error-fade 0.3s ease;
    }

    @keyframes error-fade {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-footer {
      margin-top: 2rem;
      font-size: 12px;
      color: rgba(148, 163, 184, 0.5);
      text-align: center;
    }

    .login-footer a { color: #94A3B8; text-decoration: none; }
    .login-footer a:hover { color: var(--vendo-green); }

    @media (max-width: 768px) {
      body { padding: 1.5rem; }
      .login-brand { font-size: 24px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
      .bg-orb { animation: none !important; }
    }
  </style>
</head>
<body>
  <!-- Animated background orbs -->
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>

  <main class="login-container" aria-label="Set a new password">
    <div class="login-logo">V</div>
    <div class="login-brand">Set a new password</div>
    <div class="login-subtitle">You must set a new password before continuing.</div>

    <div class="login-card<% if (it.error) { %> shake<% } %>" id="cp-card">
      <% if (it.error) { %>
        <p class="error-text" role="alert"><%= it.error %></p>
      <% } %>
      <form method="POST" action="/change-password" id="cp-form">
        <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />

        <div class="field">
          <label for="password">New Password</label>
          <div class="password-wrap">
            <input type="password" id="password" name="password" placeholder="Minimum 8 characters"
                   autocomplete="new-password" required minlength="8" autofocus>
            <button type="button" class="password-toggle" data-target="password"
                    aria-label="Show password" aria-pressed="false">
              <svg class="pw-icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="pw-icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="field">
          <label for="confirm">Confirm Password</label>
          <div class="password-wrap">
            <input type="password" id="confirm" name="confirm" placeholder="Re-enter password"
                   autocomplete="new-password" required minlength="8">
            <button type="button" class="password-toggle" data-target="confirm"
                    aria-label="Show password" aria-pressed="false">
              <svg class="pw-icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="pw-icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="login-btn">Set Password</button>
      </form>
    </div>

    <p class="login-footer"><a href="/logout">Log out</a></p>
  </main>

  <script>
  (function() {
    document.querySelectorAll('.password-toggle').forEach(function(toggle) {
      var field = document.getElementById(toggle.getAttribute('data-target'));
      var iconShow = toggle.querySelector('.pw-icon-show');
      var iconHide = toggle.querySelector('.pw-icon-hide');
      toggle.addEventListener('click', function() {
        var showing = field.type === 'text';
        field.type = showing ? 'password' : 'text';
        toggle.setAttribute('aria-pressed', showing ? 'false' : 'true');
        toggle.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
        iconShow.style.display = showing ? '' : 'none';
        iconHide.style.display = showing ? 'none' : '';
        field.focus();
      });
    });
  })();
  </script>
</body>
</html>
