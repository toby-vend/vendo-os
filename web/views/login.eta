<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Vendo OS</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --vendo-font: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
      --vendo-green: #22C55E;
      --vendo-green-hover: #16A34A;
    }

    body {
      font-family: var(--vendo-font);
      background: #0B0B0B;
      color: #E2E8F0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      overflow: hidden;
      position: relative;
    }

    /* === Animated gradient orbs === */
    .bg-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.07;
      pointer-events: none;
      will-change: transform;
    }

    .bg-orb-1 {
      width: 600px;
      height: 600px;
      background: var(--vendo-green);
      top: -10%;
      left: -10%;
      animation: orb-drift-1 25s ease-in-out infinite;
    }

    .bg-orb-2 {
      width: 500px;
      height: 500px;
      background: #10B981;
      bottom: -15%;
      right: -10%;
      animation: orb-drift-2 30s ease-in-out infinite;
    }

    .bg-orb-3 {
      width: 350px;
      height: 350px;
      background: #FFFFFF;
      top: 40%;
      right: 30%;
      opacity: 0.03;
      animation: orb-drift-3 20s ease-in-out infinite;
    }

    @keyframes orb-drift-1 {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(80px, 50px); }
      66% { transform: translate(-40px, 80px); }
    }

    @keyframes orb-drift-2 {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(-60px, -40px); }
      66% { transform: translate(50px, -70px); }
    }

    @keyframes orb-drift-3 {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-30px, 40px); }
    }

    /* === Noise texture overlay === */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      opacity: 0.035;
      pointer-events: none;
      z-index: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 128px 128px;
    }

    /* === Dot grid === */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
      background-image: radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .login-container {
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 1;
      animation: card-enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes card-enter {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Logo */
    .login-logo {
      width: 64px;
      height: 64px;
      background: var(--vendo-green);
      color: #0B0B0B;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--vendo-font);
      font-weight: 700;
      font-size: 32px;
      margin-bottom: 1.5rem;
      box-shadow: 0 0 40px rgba(34, 197, 94, 0.2);
    }

    /* Brand name */
    .login-brand {
      font-family: var(--vendo-font);
      font-size: 32px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    /* Typewriter area */
    .typewriter-wrap {
      height: 32px;
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .typewriter-text {
      font-family: var(--vendo-font);
      font-size: 18px;
      font-weight: 400;
      color: var(--vendo-green);
      letter-spacing: -0.01em;
    }

    .typewriter-cursor {
      display: inline-block;
      width: 2px;
      height: 22px;
      background: var(--vendo-green);
      margin-left: 2px;
      vertical-align: middle;
      animation: blink 0.5s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    /* Card — glassmorphism */
    .login-card {
      background: rgba(20, 20, 20, 0.55);
      backdrop-filter: saturate(180%) blur(40px);
      -webkit-backdrop-filter: saturate(180%) blur(40px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      padding: 2rem;
      width: 100%;
      transition: transform 0.3s ease;
    }

    /* Shake on error */
    .login-card.shake {
      animation: shake 0.4s ease-in-out;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-5px); }
      80% { transform: translateX(5px); }
    }

    .login-card label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #94A3B8;
      margin-bottom: 0.5rem;
    }

    .login-card input[type="email"],
    .login-card input[type="password"],
    .login-card input[type="text"] {
      width: 100%;
      padding: 0.75rem 1rem;
      background: rgba(11, 11, 11, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      color: #E2E8F0;
      font-family: var(--vendo-font);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .login-card input:focus {
      border-color: var(--vendo-green);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }

    .login-card input::placeholder {
      color: #64748b;
    }

    /* Password field wrapper */
    .password-wrap {
      position: relative;
    }

    .password-wrap input {
      padding-right: 3rem;
    }

    .password-toggle {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      padding: 4px;
      cursor: pointer;
      color: #64748b;
      transition: color 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 6px;
    }

    .password-toggle:hover {
      color: #94A3B8;
      background: rgba(255, 255, 255, 0.04);
      box-shadow: none;
      transform: translateY(-50%);
    }

    .password-toggle svg {
      width: 18px;
      height: 18px;
    }

    /* Submit button */
    .login-btn {
      width: 100%;
      margin-top: 1.25rem;
      padding: 0.75rem 1.25rem;
      background: var(--vendo-green);
      color: #0B0B0B;
      border: none;
      border-radius: 14px;
      font-family: var(--vendo-font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 48px;
    }

    .login-btn:hover {
      background: var(--vendo-green-hover);
      box-shadow: 0 0 24px rgba(34, 197, 94, 0.25);
      transform: scale(1.02);
    }

    .login-btn:active {
      transform: scale(0.98);
    }

    .login-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    .login-btn:disabled:hover {
      box-shadow: none;
      transform: none;
    }

    /* Spinner */
    .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(11, 11, 11, 0.3);
      border-top-color: #0B0B0B;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      display: none;
    }

    .login-btn.loading .spinner { display: block; }
    .login-btn.loading .btn-label { display: none; }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Google sign-in button */
    .google-btn {
      width: 100%;
      padding: 0.85rem 1.25rem;
      background: #FFFFFF;
      color: #1F2937;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      font-family: var(--vendo-font);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      min-height: 50px;
    }

    .google-btn:hover {
      box-shadow: 0 0 24px rgba(255, 255, 255, 0.12);
      transform: scale(1.02);
    }

    .google-btn:active { transform: scale(0.98); }

    .google-btn.loading {
      opacity: 0.7;
      pointer-events: none;
    }

    .google-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .login-help {
      margin-top: 1rem;
      text-align: center;
      font-size: 12px;
      color: rgba(148, 163, 184, 0.6);
      line-height: 1.5;
    }

    /* Flagged (no account) note */
    .flagged-note {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      margin-bottom: 1.25rem;
      font-size: 13px;
      line-height: 1.5;
      color: #FCD34D;
    }

    .flagged-note strong {
      display: block;
      margin-bottom: 0.25rem;
      color: #FBBF24;
    }

    /* Error message */
    .error-text {
      color: #ef4444;
      font-weight: 600;
      text-align: center;
      font-size: 14px;
      margin-bottom: 1rem;
      animation: error-fade 0.3s ease;
    }

    @keyframes error-fade {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-footer {
      margin-top: 2rem;
      font-size: 12px;
      color: rgba(148, 163, 184, 0.5);
      text-align: center;
    }

    .keyboard-hint {
      text-align: center;
      margin-top: 0.75rem;
      font-size: 11px;
      color: rgba(148, 163, 184, 0.35);
      letter-spacing: 0.02em;
    }

    .keyboard-hint kbd {
      display: inline-block;
      padding: 1px 6px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      font-family: var(--vendo-font);
      font-size: 10px;
    }

    @media (max-width: 768px) {
      .keyboard-hint { display: none; }

      body { padding: 1.5rem; }

      .login-brand { font-size: 26px; }

      .typewriter-text { font-size: 16px; }
    }

    /* Reduce motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
      .bg-orb { animation: none !important; }
    }
  </style>
</head>
<body>
  <!-- Animated background orbs -->
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>
  <div class="bg-orb bg-orb-3"></div>

  <main class="login-container" aria-label="Sign in">
    <div class="login-logo">V</div>
    <div class="login-brand">Vendo Digital</div>
    <div class="typewriter-wrap">
      <span class="typewriter-text" id="typewriter"></span><span class="typewriter-cursor"></span>
    </div>

    <div class="login-card<% if (it.error) { %> shake<% } %>" id="login-card">
      <% if (it.flagged) { %>
        <div class="flagged-note" role="status">
          <strong>Your account isn't set up yet.</strong>
          We've let the Vendo admins know — you'll be able to sign in once they've added you.
        </div>
      <% } else if (it.error) { %>
        <p class="error-text" role="alert"><%= it.error %></p>
      <% } %>

      <a href="/auth/google/login" class="google-btn" id="google-btn">
        <svg class="google-icon" viewBox="0 0 18 18" aria-hidden="true">
          <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.97 10.72A5.4 5.4 0 0 1 3.68 9c0-.6.1-1.18.29-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.82.96 4.05l3.01-2.33z"/>
          <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59C13.47.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <p class="login-help">Use your Vendo Google account. Access is granted by an admin.</p>
    </div>

    <p class="login-footer">Vendo OS &mdash; Team Dashboard</p>
  </main>

  <script>
  (function() {
    /* Typewriter */
    var words = ["Driving Strategic Digital Growth", "We Are Vendo Digital"];
    var el = document.getElementById('typewriter');
    var speed = 80, deleteSpeed = 40, pauseAfterWord = 2000, pauseAfterDelete = 500;
    var wordIdx = 0, charIdx = 0, deleting = false;

    function tick() {
      var word = words[wordIdx];
      if (!deleting) {
        charIdx++;
        el.textContent = word.slice(0, charIdx);
        if (charIdx === word.length) { setTimeout(function() { deleting = true; tick(); }, pauseAfterWord); return; }
        setTimeout(tick, speed);
      } else {
        charIdx--;
        el.textContent = word.slice(0, charIdx);
        if (charIdx === 0) { deleting = false; wordIdx = (wordIdx + 1) % words.length; setTimeout(tick, pauseAfterDelete); return; }
        setTimeout(tick, deleteSpeed);
      }
    }
    setTimeout(tick, 600);

    /* Loading state when the user clicks through to Google */
    var googleBtn = document.getElementById('google-btn');
    if (googleBtn) {
      googleBtn.addEventListener('click', function() {
        googleBtn.classList.add('loading');
        googleBtn.setAttribute('aria-busy', 'true');
      });
    }
  })();
  </script>
</body>
</html>
