<% layout('/layouts/base') %>

<link rel="stylesheet" href="/assets/reports.css" />

<div style="max-width: 1100px; margin: 0 auto;" class="r-editor">

  <div class="r-editor-header card">
    <div>
      <h2 style="font-size: 22px; font-weight: 600; margin: 0;">
        <%= it.report.client_display_name || it.report.client_name %>
        <span class="r-muted" style="font-weight: 400;">— <%= it.report.period_label %></span>
      </h2>
      <p class="r-muted" style="margin: 0.25rem 0 0; font-size: 13px;">
        <span class="r-status r-status-<%= it.report.status %>"><%= it.report.status %></span>
        · Created by <%= it.report.created_by %>
        · Updated <%= it.report.updated_at.slice(0, 16).replace('T', ' ') %>
      </p>
    </div>
    <div class="r-header-actions">
      <span id="r-save-flash" class="r-saved" style="opacity: 0;">Saved</span>
      <a class="r-btn r-btn-ghost" href="/reports/<%= it.report.id %>/text" target="_blank">Copy text</a>
      <a class="r-btn r-btn-ghost" href="/reports/<%= it.report.id %>/preview" target="_blank">Preview / PDF</a>
      <a class="r-btn r-btn-ghost" href="/reports/<%= it.report.id %>/view" target="_blank">Open dashboard</a>

      <% if (it.report.status === 'draft') { %>
        <button class="r-btn r-btn-primary"
                hx-post="/api/reports/<%= it.report.id %>/submit-review"
                hx-confirm="Submit this report for AM review?">
          Submit for review
        </button>
      <% } else if (it.report.status === 'review') { %>
        <% if (it.isAm) { %>
          <button class="r-btn r-btn-primary"
                  hx-post="/api/reports/<%= it.report.id %>/approve"
                  hx-confirm="Approve and send to the client portal?">
            Approve and send
          </button>
        <% } %>
        <button class="r-btn r-btn-ghost"
                hx-post="/api/reports/<%= it.report.id %>/reopen"
                hx-confirm="Send this back to draft? The submission will be cleared.">
          Reopen
        </button>
      <% } else if (it.report.status === 'final') { %>
        <button class="r-btn r-btn-ghost"
                hx-post="/api/reports/<%= it.report.id %>/reopen"
                hx-confirm="Reopen this report? It will return to draft and the approval will be cleared.">
          Reopen
        </button>
      <% } %>

      <button class="r-btn r-btn-danger"
              hx-post="/api/reports/<%= it.report.id %>/delete"
              hx-confirm="Delete this report and all screenshots? This can't be undone.">
        Delete
      </button>
    </div>
  </div>

  <!-- Month + channel selector. Channels are kept pure: switching channel
       loads that channel's separate report (or offers to generate it). -->
  <div class="r-channel-bar card" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:12px;">
    <strong style="font-size:13px;">Channel:</strong>
    <% it.channelOptions.forEach(function(c){ %>
      <% var sid = it.siblingByChannel[c.value]; %>
      <% if (c.value === it.report.channel) { %>
        <span class="r-btn r-btn-primary" style="cursor:default;"><%= c.label %></span>
      <% } else if (sid) { %>
        <a class="r-btn r-btn-ghost" href="/reports/<%= sid %>"><%= c.label %></a>
      <% } else { %>
        <a class="r-btn r-btn-ghost" style="opacity:.55;"
           href="/reports/switch?clientId=<%= it.report.client_id %>&month=<%= it.monthValue %>&channel=<%= c.value %>"
           title="No <%= c.label %> report for this month yet — click to generate">+ <%= c.label %></a>
      <% } %>
    <% }); %>

    <form method="GET" action="/reports/switch" style="display:flex; gap:8px; align-items:center; margin-left:auto;">
      <input type="hidden" name="clientId" value="<%= it.report.client_id %>" />
      <input type="hidden" name="channel" value="<%= it.report.channel %>" />
      <label class="r-muted" style="font-size:13px;">Month</label>
      <input type="month" name="month" value="<%= it.monthValue %>"
             style="background:var(--vendo-surface); color:inherit; border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:6px 8px;" />
      <button class="r-btn r-btn-ghost" type="submit">Go</button>
    </form>
  </div>

  <!-- Status audit strip — surfaces who submitted / approved + when. -->
  <% if (it.report.status === 'review' && it.report.submitted_for_review_at) { %>
    <div class="card r-section" style="border-left: 3px solid var(--vendo-amber, #FACC15); padding: 0.75rem 1rem;">
      <p class="r-muted" style="margin: 0; font-size: 13px;">
        Submitted for review by <strong><%= it.report.submitted_for_review_by %></strong>
        on <%= it.report.submitted_for_review_at.slice(0, 16).replace('T', ' ') %>.
        <% if (!it.isAm) { %>
          Waiting on an Account Manager to approve.
        <% } %>
      </p>
    </div>
  <% } else if (it.report.status === 'final' && it.report.approved_at) { %>
    <div class="card r-section" style="border-left: 3px solid var(--vendo-green, #5EEAD4); padding: 0.75rem 1rem;">
      <p class="r-muted" style="margin: 0; font-size: 13px;">
        Approved by <strong><%= it.report.approved_by %></strong>
        on <%= it.report.approved_at.slice(0, 16).replace('T', ' ') %>.
        Portal delivery runs every 15 minutes.
      </p>
    </div>
  <% } %>

  <!-- Recipient -->
  <section class="card r-section">
    <header class="r-section-head">
      <h3>1. Who's the report addressed to?</h3>
      <p class="r-muted">First name of the client contact (e.g. "Adam"). Used in the email-style greeting on the preview page. Leave blank to skip the greeting.</p>
    </header>
    <input class="r-textarea"
           type="text"
           name="contact_name"
           value="<%= it.report.contact_name %>"
           placeholder="e.g. Adam"
           maxlength="100"
           style="max-width: 320px;"
           hx-post="/api/reports/<%= it.report.id %>/narrative"
           hx-trigger="blur changed delay:500ms"
           hx-swap="none" />
  </section>

  <!-- Performance -->
  <section class="card r-section">
    <header class="r-section-head" style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem;">
      <div>
        <h3>2. Performance</h3>
        <p class="r-muted">Upload a <strong>CSV export of the campaign data</strong> (best — the AI reads the figures directly) and/or performance screenshots. Tag the platform and add a short caption. The AI treats CSV figures as canonical.</p>
      </div>
      <% if (it.report.channel === 'google_ads') { %>
      <div style="text-align:right; flex-shrink:0;">
        <button class="r-btn r-btn-primary" style="white-space:nowrap;"
                hx-post="/api/reports/<%= it.report.id %>/pull-google-ads"
                hx-swap="none"
                hx-indicator="#r-gads-spin"
                hx-confirm="Pull the latest Google Ads metrics + change history and (re)generate this report? This overwrites the AI sections.">
          Pull Google Ads data
        </button>
        <div id="r-gads-spin" class="htmx-indicator r-muted" style="font-size:12px; margin-top:6px;">Pulling metrics + change history & generating… (~20s)</div>
      </div>
      <% } %>
    </header>

    <form id="r-upload-form"
          hx-post="/api/reports/<%= it.report.id %>/screenshots"
          hx-target="#r-screenshots-list"
          hx-swap="beforeend"
          hx-encoding="multipart/form-data"
          hx-target-4xx="#r-upload-error"
          hx-target-5xx="#r-upload-error"
          class="r-upload-form">
      <label class="r-field" style="flex: 0 0 180px;">
        <span>Platform</span>
        <select name="platform" required>
          <option value="">Pick…</option>
          <% (it.channelPlatforms || it.platforms).forEach(function(p){ %>
            <option value="<%= p.value %>"><%= p.label %></option>
          <% }); %>
        </select>
      </label>
      <label class="r-field" style="flex: 1;">
        <span>Caption (optional)</span>
        <input type="text" name="caption" placeholder="e.g. Spend up 12% MoM, ROAS 3.4 → 4.1" maxlength="500" />
      </label>
      <label class="r-field" style="flex: 0 0 260px;">
        <span>File (CSV, or PNG / JPEG / WebP image)</span>
        <input type="file" name="file" accept=".csv,text/csv,image/png,image/jpeg,image/webp" required />
      </label>
      <button type="submit" class="r-btn r-btn-primary" id="r-upload-btn">Add</button>
    </form>
    <div id="r-upload-error" style="margin-top: 0.5rem;"></div>

    <div id="r-screenshots-list" class="r-screenshots">
      <% it.screenshots.forEach(function(s){ %>
        <%~ include('/reports/_screenshot-card', { screenshot: s, platforms: it.platforms }) %>
      <% }); %>
    </div>
  </section>

  <% /* Change history — Google Ads only. Gives the AI concrete account changes. */ %>
  <% if (it.report.channel === 'google_ads') { %>
  <section class="card r-section">
    <header class="r-section-head">
      <h3>2a. Change history</h3>
      <p class="r-muted">Paste the Google Ads <strong>Change History</strong> for the month (Tools → Change history → export/copy). The AI uses it to explain what changed and ground "what we did" — it won't appear verbatim in the report. <span id="r-ch-autopull"></span></p>
    </header>
    <div style="display:flex; gap:8px; margin-bottom:8px;">
      <button type="button" class="r-btn r-btn-ghost r-btn-sm"
              hx-post="/api/reports/<%= it.report.id %>/pull-change-history"
              hx-target="#r-change-history"
              hx-swap="outerHTML"
              hx-indicator="#r-ch-spin">
        Auto-pull from Google Ads
      </button>
      <span id="r-ch-spin" class="htmx-indicator r-muted" style="font-size:12px; align-self:center;">Pulling…</span>
    </div>
    <%~ include('/reports/_change-history-field', { report: it.report }) %>
  </section>
  <% } %>

  <!-- What we worked on -->
  <section class="card r-section">
    <header class="r-section-head">
      <h3>3. What we worked on</h3>
      <p class="r-muted">Plain language. Bullets. Markdown supported.</p>
    </header>

    <% if (it.report.narrative_draft_md && it.report.status === 'draft') { %>
      <%~ include('/reports/_suggested-narrative', { report: it.report, md: it.md, csrfToken: it.csrfToken }) %>
    <% } %>

    <textarea class="r-textarea"
              name="worked_on_md"
              rows="8"
              placeholder="- Launched the new high-intent search campaign on May 3rd…&#10;- Refreshed Meta creatives — 6 new variants live"
              hx-post="/api/reports/<%= it.report.id %>/narrative"
              hx-trigger="blur changed delay:500ms"
              hx-swap="none"
    ><%= it.report.worked_on_md %></textarea>
  </section>

  <!-- Focus next period -->
  <section class="card r-section">
    <header class="r-section-head">
      <h3>4. Focus next period <span class="r-muted" style="font-weight:400; font-size:13px;">(optional)</span></h3>
      <p class="r-muted">What's the plan for next month? Leave blank to let the AI write the "Next month" section itself — it isn't required.</p>
    </header>
    <textarea class="r-textarea"
              name="focus_next_md"
              rows="8"
              placeholder="- Test broad-match expansion on Google Ads&#10;- Brief two new UGC creators for Meta"
              hx-post="/api/reports/<%= it.report.id %>/narrative"
              hx-trigger="blur changed delay:500ms"
              hx-swap="none"
    ><%= it.report.focus_next_md %></textarea>
  </section>

  <!-- AI Insights -->
  <section class="card r-section">
    <header class="r-section-head" style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <h3>5. AI insights</h3>
        <p class="r-muted">Executive summary, performance breakdown, wins, risks, and recommendations — generated from the screenshots and narrative above.</p>
      </div>
      <button id="r-generate-btn"
              class="r-btn r-btn-primary"
              hx-post="/api/reports/<%= it.report.id %>/generate"
              hx-target="#r-ai-blocks"
              hx-swap="outerHTML"
              hx-indicator="#r-generate-spinner">
        <span class="r-generate-label"><%= it.report.ai_generated_at ? 'Regenerate' : 'Generate' %></span>
        <span id="r-generate-spinner" class="htmx-indicator">…thinking</span>
      </button>
    </header>

    <%~ include('/reports/_ai-blocks', { report: it.report }) %>
  </section>

</div>

<script>
  // Save flash — show "Saved" briefly when an HTMX swap returns one.
  document.body.addEventListener('htmx:afterSwap', function(){
    var f = document.getElementById('r-save-flash');
    if (!f) return;
    f.style.opacity = '1';
    clearTimeout(window._rSaveTimer);
    window._rSaveTimer = setTimeout(function(){ f.style.opacity = '0'; }, 1200);
  });

  // Upload form lifecycle — clear the error chip on submit, reset file input
  // after a successful upload, and show a fallback error if the request
  // never reached the server (e.g. Vercel rejected with 413 before our route
  // ran, in which case responseError fires with a generic message).
  (function(){
    var form = document.getElementById('r-upload-form');
    var errBox = document.getElementById('r-upload-error');
    var btn = document.getElementById('r-upload-btn');
    if (!form || !errBox || !btn) return;

    form.addEventListener('htmx:beforeRequest', function(){
      errBox.innerHTML = '';
      btn.disabled = true;
      btn.textContent = 'Uploading…';
    });
    form.addEventListener('htmx:afterRequest', function(evt){
      btn.disabled = false;
      btn.textContent = 'Add';
      var xhr = evt.detail.xhr;
      if (evt.detail.successful) {
        // Reset file input + caption; keep platform selection for next shot.
        var fileInput = form.querySelector('input[type="file"]');
        var captionInput = form.querySelector('input[name="caption"]');
        if (fileInput) fileInput.value = '';
        if (captionInput) captionInput.value = '';
      } else if (xhr) {
        var status = xhr.status;
        if (status === 0) {
          errBox.innerHTML = '<div class="r-error">Network error. Check your connection and try again.</div>';
        } else if (status === 413) {
          errBox.innerHTML = '<div class="r-error">File too large. Resize the screenshot or save it at lower quality and try again (max 4MB).</div>';
        } else if (!xhr.responseText) {
          errBox.innerHTML = '<div class="r-error">Upload failed (HTTP ' + status + ').</div>';
        }
        // For other 4xx/5xx, the response body is already swapped into errBox by hx-target-{4xx,5xx}.
      }
    });
  })();
</script>
