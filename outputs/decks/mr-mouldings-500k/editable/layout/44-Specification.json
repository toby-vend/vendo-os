"size": 13, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], "align": "start", "lh": 19.5, "bullet": false, "inline": false}, {"k": "rect", "x": 88, "y": 549.625, "w": 540, "h": 124.390625, "fill": "rgba(142, 254, 187, 0.09)", "line": "rgba(142, 254, 187, 0.3)", "lw": 1, "radius": 14}, {"k": "text", "x": 115, "y": 575.625, "w": 486, "h": 71.59375, "runs": [{"t": "Do not build SEO for this audience.", "color": "rgb(142, 254, 187)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " ", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}, {"t": "The \u00a38,900 tulipwood orders in the order book are the proof of concept: this channel already converts when it finds you. It needs to be sold to, not ranked for.", "color": "rgb(185, 199, 192)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], "align": "start", "lh": 24.8, "bullet": false, "inline": false}, {"k": "rect", "x": 668, "y": 231.328125, "w": 844, "h": 360, "fill": "rgb(9, 34, 31)", "line": "rgba(255, 255, 255, 0.08)", "lw": 1, "radius": 14}, {"k": "text", "x": 695, "y": 256.328125, "w": 790, "h": 26, "runs": [{"t": "What the specification channel actually needs", "color": "rgb(255, 255, 255)", "size": 19, "weight": 700, "italic": false, "font": "Manrope", "ls": -0.19}], "align": "start", "lh": 23.75, "bullet": false, "inline": false}, {"k": "text", "x": 695, "y": 290.328125, "w": 790, "h": 276, "align": "start", "lh": 24, "indent": 20, "gap": 9, "paras": [[{"t": "An NBS Source listing.", "color": "rgb(255, 255, 255)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " The platform architects and specifiers use to write products into build documents. This is the single highest-leverage item on the list", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "Sample boxes.", "color": "rgb(255, 255, 255)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " A physical, branded set that sits on a studio shelf. Specifiers choose from what is in front of them", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "CAD and detail drawings.", "color": "rgb(255, 255, 255)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " DWG profiles and NBS-ready specification clauses, downloadable per profile. Without these the product cannot be drawn into a job", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "Named outbound.", "color": "rgb(255, 255, 255)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " Architects and interior designers working on period and high-end residential, approached directly \u2014 not through a form", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "A trade contact route.", "color": "rgb(255, 255, 255)", "size": 16, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}, {"t": " Somebody who answers a specification question in an hour, not a general enquiry inbox", "color": "rgb(232, 242, 236)", "size": 16, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}]], "bullet": true}, {"k": "rect", "x": 668, "y": 611.328125, "w": 844, "h": 151.4375, "fill": "rgb(9, 34, 31)", "line": "rgba(255, 255, 255, 0.08)", "lw": 1, "radius": 14}, {"k": "text", "x": 695, "y": 637.328125, "w": 790, "h": 15, "runs": [{"t": "THE ECONOMICS", "color": "rgb(107, 123, 116)", "size": 11, "weight": 700, "italic": false, "font": "Manrope", "ls": 1.76}], "align": "start", "lh": 17.05, "bullet": false, "inline": false}, {"k": "text", "x": 695, "y": 664.375, "w": 790, "h": 71.59375, "runs": [{"t": "One specified job at the current tulipwood average of \u00a38,900 is worth twenty ordinary orders. Three of the