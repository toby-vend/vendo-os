{"bg": "rgb(5, 20, 18)", "items": [{"k": "text", "x": 88, "y": 60, "w": 1424, "h": 17, "runs": [{"t": "08 \u00b7 PAID CREATIVE \u00b7 PERSONA", "color": "rgb(142, 254, 187)", "size": 12, "weight": 700, "italic": false, "font": "Manrope", "ls": 2.16}], "align": "start", "lh": 18.6, "bullet": false, "inline": false}, {"k": "text", "x": 88, "y": 90.59375, "w": 946.28125, "h": 70, "runs": [{"t": "Sophie", "color": "rgb(255, 255, 255)", "size": 54, "weight": 400, "italic": true, "font": "Instrument Serif", "ls": -0.54}], "align": "start", "lh": 57.24, "bullet": false, "inline": false}, {"k": "text", "x": 88, "y": 171.828125, "w": 950.375, "h": 26, "runs": [{"t": "Period restorer, Victorian or Edwardian terrace", "color": "rgb(185, 199, 192)", "size": 19, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], "align": "start", "lh": 28.5, "bullet": false, "inline": false}, {"k": "text", "x": 88, "y": 444.40625, "w": 400, "h": 24, "runs": [{"t": "D2C", "color": "rgb(5, 20, 18)", "size": 10, "weight": 700, "italic": false, "font": "Manrope", "ls": 1.4}], "align": "start", "lh": 20, "bullet": false, "inline": false}, {"k": "text", "x": 88, "y": 490.40625, "w": 400, "h": 22, "runs": [{"t": "In one line", "color": "rgb(142, 254, 187)", "size": 17, "weight": 400, "italic": true, "font": "Instrument Serif", "ls": 0}], "align": "start", "lh": 26.35, "bullet": false, "inline": false}, {"k": "text", "x": 88, "y": 519.75, "w": 400, "h": 97.78125, "runs": [{"t": "Wants authenticity and will pay for a match to what is already in the house.", "color": "rgb(255, 255, 255)", "size": 24, "weight": 700, "italic": false, "font": "Manrope", "ls": 0}], "align": "start", "lh": 32.4, "bullet": false, "inline": false}, {"k": "rect", "x": 510, "y": 302.5, "w": 494, "h": 174.34375, "fill": "rgb(9, 34, 31)", "line": "rgba(255, 255, 255, 0.08)", "lw": 1, "radius": 14}, {"k": "text", "x": 533, "y": 325.5, "w": 448, "h": 22, "runs": [{"t": "What they buy", "color": "rgb(142, 254, 187)", "size": 17, "weight": 400, "italic": true, "font": "Instrument Serif", "ls": 0}], "align": "start", "lh": 26.35, "bullet": false, "inline": false}, {"k": "text", "x": 533, "y": 355.84375, "w": 448, "h": 95, "align": "start", "lh": 22.5, "indent": 20, "gap": 5, "paras": [[{"t": "Made to match profiles for rooms where the original skirting is still in place.", "color": "rgb(185, 199, 192)", "size": 15, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "Tall profiles, dado and picture rails, the details that were stripped out in the seventies.", "color": "rgb(185, 199, 192)", "size": 15, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}]], "bullet": true}, {"k": "rect", "x": 1018, "y": 302.5, "w": 494, "h": 174.34375, "fill": "rgb(9, 34, 31)", "line": "rgba(255, 255, 255, 0.08)", "lw": 1, "radius": 14}, {"k": "text", "x": 1041, "y": 325.5, "w": 448, "h": 22, "runs": [{"t": "What stops them", "color": "rgb(142, 254, 187)", "size": 17, "weight": 400, "italic": true, "font": "Instrument Serif", "ls": 0}], "align": "start", "lh": 26.35, "bullet": false, "inline": false}, {"k": "text", "x": 1041, "y": 355.84375, "w": 448, "h": 50, "align": "start", "lh": 22.5, "indent": 20, "gap": 5, "paras": [[{"t": "Believes a match is only possible in solid timber.", "color": "rgb(185, 199, 192)", "size": 15, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}], [{"t": "Worries MDF is a compromise in a period house.", "color": "rgb(185, 199, 192)", "size": 15, "weight": 400, "italic": false, "font": "Manrope", "ls": 0}]], "bullet": true}, {"k": "rect", "x": 510, "y": 490.84375, "w": 1002, "h": 156.84375, "fill": "rgb(9, 34, 31)", "line": "rgba(255, 255, 255, 0.08)", "lw": 1, "radius": 14}, {"k": "text", "x": 533, "y": 513.84375, "w": 956, "h": 22, "runs": [{"t": "Hook angles", "color": "rgb(142, 254, 187)", "size": 17, "weight": 400, "italic": true, "font": "Instrument Serif", "ls": 0}], "align": "start", "lh": 26.35, "bullet": false, "inline": false}, {"k":